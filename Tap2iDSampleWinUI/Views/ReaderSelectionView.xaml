<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tap2iDSampleWinUI.Views.ReaderSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Select Reader (per capability)" FontSize="16" FontFamily="Arial" VerticalAlignment="Center"/>

            <ProgressRing Grid.Column="1" Width="16" Height="16" Margin="0,0,8,0"
                          IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"/>

            <!-- Rescans for readers plugged in after startup; without this the lists are only
                 ever filled once, at SDK init. -->
            <Button Grid.Column="2" Content="Refresh" FontFamily="Arial"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Re-scan for connected readers"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="QR" FontSize="14" FontFamily="Arial"/>
                <ComboBox HorizontalAlignment="Stretch"
                          DisplayMemberPath="Label"
                          IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.QrOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedQr, Mode=TwoWay}"/>
                <TextBlock Text="{x:Bind ViewModel.QrStatus, Mode=OneWay}"
                           FontSize="12" FontFamily="Arial" Foreground="Gray"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                <TextBlock Text="NFC" FontSize="14" FontFamily="Arial"/>
                <ComboBox HorizontalAlignment="Stretch"
                          DisplayMemberPath="Label"
                          IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.NfcOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedNfc, Mode=TwoWay}"/>
                <TextBlock Text="{x:Bind ViewModel.NfcStatus, Mode=OneWay}"
                           FontSize="12" FontFamily="Arial" Foreground="Gray"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="BLE" FontSize="14" FontFamily="Arial"/>
                <ComboBox HorizontalAlignment="Stretch"
                          DisplayMemberPath="Label"
                          IsEnabled="{x:Bind ViewModel.IsEnabled, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.BleOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedBle, Mode=TwoWay}"/>
                <TextBlock Text="{x:Bind ViewModel.BleStatus, Mode=OneWay}"
                           FontSize="12" FontFamily="Arial" Foreground="Gray"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.RefreshError, Mode=OneWay}"
                   FontSize="12" FontFamily="Arial" Foreground="#B22222"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
