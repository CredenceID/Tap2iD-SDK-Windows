<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tap2iDSampleWinUI.CameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tap2iDSampleWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Camera"
    >
    <Grid
    Grid.Row="0" Grid.Column="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

        <!-- MediaPlayerElement (Camera) -->
        <StackPanel
            x:Name="CameraPanel"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1E534B">
            <MediaPlayerElement
                    x:Name="player"
                    AutoPlay="True" />
        </StackPanel>

        <!-- Shown when no camera could be opened; the reason is in the main window's logs -->
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <!-- Flip camera button, bottom-right; shown only when more than one camera exists -->
        <Button x:Name="FlipCameraButton"
                Click="FlipCameraButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Width="52" Height="52"
                CornerRadius="26"
                Background="#CC1E534B"
                BorderThickness="0"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Switch camera">
            <FontIcon Glyph="&#xE892;" FontSize="22" Foreground="White"/>
        </Button>

    </Grid>
</Window>
